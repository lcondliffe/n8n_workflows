    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Clone a Git repo\n\nIMPORTANT PATH RULES:\n\nBase path must be '/home/node/.n8n-files'\n\nUse a unique sub-directory for each repo. ",
        "operation": "clone",
        "repositoryPath": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('New_Repository_Path', ``, 'string') }}",
        "sourceRepository": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Source_Repository', ``, 'string') }}"
      },
      "id": "git-tool-node-id",
      "name": "Git Tool",
      "type": "n8n-nodes-base.gitTool",
      "typeVersion": 1.1,
      "position": [
        1024,
        432
      ]
    },
    {
      "parameters": {
        "description": "Read files and explore directories in n8n-files\n\nPATH FORMAT: Use /home/node/.n8n-files (same as Git Tool)\n\nACTIONS:\n1. 'read': Read file contents\n   Input: {path: '/README.md', action: 'read'}\n   Returns: File content as text\n\n2. 'list': List directory contents  \n   Input: {path: '/home/node/.n8n-files/src', action: 'list'}\n   Returns: Array of files with type and size\n\n3. 'find': Find files by pattern\n   Input: {path: '/home/node/.n8n-files/owner-repo', action: 'find', pattern: '*.js'}\n   Returns: Array of matching file paths\n\nWORKFLOW:\n1. Clone repo with Git Tool to /home/node/.n8n-files/REPO_NAME\n2. Use this tool to explore files in /home/node/.n8n-files\n3. Remember to use same path from Git clone",
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\nconst filePath = $input.path || '/tmp';\nconst action = $input.action || 'list';\nconst pattern = $input.pattern || '*';\n\ntry {\n  if (action === 'read') {\n    const content = fs.readFileSync(filePath, 'utf8');\n    return { content, path: filePath, lines: content.split('\\n').length };\n  } \n  \n  if (action === 'list') {\n    const files = fs.readdirSync(filePath);\n    const details = files.map(f => {\n      const fullPath = path.join(filePath, f);\n      const stats = fs.statSync(fullPath);\n      return {\n        name: f,\n        type: stats.isDirectory() ? 'directory' : 'file',\n        size: stats.size,\n        modified: stats.mtime\n      };\n    });\n    return { files: details, path: filePath, count: files.length };\n  }\n  \n  if (action === 'find') {\n    const results = [];\n    const regex = new RegExp(pattern.replace(/\\*/g, '.*').replace(/\\?/g, '.'));\n    \n    function walk(dir) {\n      try {\n        const files = fs.readdirSync(dir);\n        files.forEach(f => {\n          const fullPath = path.join(dir, f);\n          const stats = fs.statSync(fullPath);\n          if (stats.isDirectory() && !f.startsWith('.')) {\n            walk(fullPath);\n          } else if (regex.test(f)) {\n            results.push(fullPath);\n          }\n        });\n      } catch (err) {\n        // Skip directories we can't read\n      }\n    }\n    \n    walk(filePath);\n    return { files: results, pattern, count: results.length };\n  }\n  \n  return { error: 'Unknown action. Use: read, list, or find' };\n  \n} catch (error) {\n  return { error: error.message, path: filePath, action };\n}"
      },
