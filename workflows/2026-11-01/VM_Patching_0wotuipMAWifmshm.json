    {
      "id": "ssh-dev01-0001-0001-0001-000000000002",
      "name": "Patch dkr-dev-01",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        460,
        180
      ],
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "cwd": "/",
        "command": "set -e\necho \"=== Patching $(hostname) at $(date) ===\"\nsudo apt-get update -y\nsudo apt-get upgrade -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\"\nsudo apt-get autoremove -y\nif [ -f /var/run/reboot-required ]; then\n  echo \"REBOOT_REQUIRED: $(hostname) needs a reboot\"\n  cat /var/run/reboot-required.pkgs 2>/dev/null || true\nelse\n  echo \"OK: $(hostname) fully patched, no reboot needed\"\nfi"
      }
    },
